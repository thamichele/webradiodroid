{
  "name": "webradiodroid",
  "productName": "WebRadioDroid",
  "version": "2.3.0",
  "description": "Webradio per Windows e Linux, gemella dell'app Android WebRadioDroid",
  "homepage": "https://github.com/thamichele/webradiodroid",
  "license": "MIT",
  "author": {
    "name": "thamichele",
    "email": "169723012+thamichele@users.noreply.github.com"
  },
  "main": "main.js",
  "desktopName": "webradiodroid.desktop",
  "private": true,
  "dependencies": {
    "hls.js": "1.7.4"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "io.github.thamichele.webradiodroid",
    "productName": "WebRadioDroid",
    "copyright": "MIT License",
    "directories": {
      "output": "dist",
      "buildResources": "buildres"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/hls.js/src/**",
      "!node_modules/hls.js/dist/!(hls.light.min.js)"
    ],
    "artifactName": "WebRadioDroid-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "WebRadioDroid",
      "artifactName": "WebRadioDroid-${version}-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "WebRadioDroid-${version}-windows-portable.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Audio",
      "executableName": "webradiodroid",
      "synopsis": "Webradio",
      "description": "Webradio per Windows e Linux, gemella dell'app Android WebRadioDroid",
      "maintainer": "thamichele <169723012+thamichele@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "desktop": {
        "entry": {
          "Name": "WebRadioDroid",
          "GenericName": "Web Radio",
          "Keywords": "radio;webradio;stream;music;"
        }
      }
    },
    "appImage": {
      "artifactName": "WebRadioDroid-${version}-linux-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "WebRadioDroid-${version}-linux-amd64.${ext}"
    },
    "publish": null
  }
}
