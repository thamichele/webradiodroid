<?xml version="1.0" encoding="utf-8"?>
<!-- JetBrains Mono for headlines: semibold (600) as regular, bold (700) as bold -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/jetbrains_mono_semibold" android:fontStyle="normal" android:fontWeight="400"
        app:font="@font/jetbrains_mono_semibold" app:fontStyle="normal" app:fontWeight="400" />
    <font android:font="@font/jetbrains_mono_bold" android:fontStyle="normal" android:fontWeight="700"
        app:font="@font/jetbrains_mono_bold" app:fontStyle="normal" app:fontWeight="700" />
</font-family>
